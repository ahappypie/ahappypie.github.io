{
  "name": "ahappypie.github.io",
  "version": "3.0.0",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "pnpm exec astro dev",
    "build": "pnpm exec astro build",
    "preview": "pnpm exec astro preview",
    "lint": "pnpm exec eslint \"src/**/*.{js,ts,astro}\"",
    "format": "pnpm exec prettier \"src/**/*\" --write",
    "build-gh-pages": "next build && touch ./docs/.nojekyll && git add ./docs",
    "changesets": "npx changeset",
    "bump": "npx changeset version && git add CHANGELOG.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahappypie/ahappypie.github.io.git"
  },
  "author": "Brian Bagdasarian",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ahappypie/ahappypie.github.io/issues"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@lucide/astro": "1.53.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tailwindcss/typography": "0.5.20",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "tailwindcss": "4.3.3",
    "prettier-plugin-tailwindcss": "0.8.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@astrojs/ts-plugin": "1.10.12"
  }
}
