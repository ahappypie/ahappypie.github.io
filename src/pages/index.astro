---
import Main from '../layouts/Main.astro';
import Footer from '../components/Footer.astro';
---

<Main>
  <section>
    <h1 class="font-medium text-2xl mb-8 tracking-tighter">
      Brian Bagdasarian
    </h1>
    <p class="prose prose-neutral dark:prose-invert">
      I'm a systems designer, platform builder, and process improver. I am
      currently seeking a strategic leadership role where I can make a long term
      impact with an organization.
    </p>
  </section>
  <section>
    <div class="prose prose-neutral dark:prose-invert">
      <p>
        I've worked across many industries, including fintech, immersive
        entertainment, ad tech, private equity, retail, and consumer packaged
        goods.
      </p>
      <p>
        In my journey, I've led transformation and construction of large scale
        data systems, internal developer platforms, and order-of-magnitude
        process efficiency increases.
      </p>
      <p>
        You can read{' '}
        <a
          href="/projects"
          class="hover:text-neutral-800 dark:hover:text-neutral-100 transition-all"
        >
          my thoughts and takeaways
        </a>{' '}
        on some of these projects, or{' '}
        <a
          href="/about"
          class="hover:text-neutral-800 dark:hover:text-neutral-100 transition-all"
        >
          learn more about me
        </a>
        .
      </p>
    </div>
  </section>
</Main>
