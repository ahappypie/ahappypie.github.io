---
const navItems = {
  '/': {
    name: 'home'
  },
  '/about': {
    name: 'about'
  },
  '/projects': {
    name: 'projects'
  }
};

const pathname = "/" + Astro.url.pathname.split("/")[1]
---
<aside class="-ml-[8px] mb-8 tracking-tight">
  <div class="lg:sticky lg:top-20">
    <nav class="flex flex-row items-start relative px-0 pb-0 fade md:overflow-auto scroll-pr6 md:relative">
      <div class="flex flex-row space-x-0 pr-10 divide-x dark:divide-gray-300 divide-gray-600">
        {Object.entries(navItems).map(([path, { name }]) => (
          <a href={path} class:list={["transition-all hover:text-neutral-800 dark:hover:text-neutral-200 flex align-middle", {"text-neutral-500": path !== pathname}]}>
            <span class="relative py-1 px-2">{name}</span>
          </a>
        ))}
      </div>
    </nav>
  </div>
</aside>