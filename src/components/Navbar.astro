---
import ThemeToggle from './ThemeToggle.astro';

const navItems = {
  '/': { name: 'home' },
  '/about': { name: 'about' },
  '/projects': { name: 'projects' }
};
const pathname = '/' + Astro.url.pathname.split('/')[1];
---

<nav class="notebook-nav" aria-label="Main navigation">
  <div class="notebook-nav-links">
    {Object.entries(navItems).map(([path, { name }]) => (
      <a href={path} aria-current={path === pathname ? 'page' : undefined}>
        {name}
      </a>
    ))}
  </div>
  <ThemeToggle />
</nav>
