---
import type { CollectionEntry } from 'astro:content';

interface Props {
  job: CollectionEntry<'resumeJobs'>;
  showTechnologies: boolean;
  respectPrintHide?: boolean;
}
const { job, showTechnologies = true, respectPrintHide = false } = Astro.props;
const { company, position, roles, work, start_month, end_month } = job.data;
const technologies = job.data.technologies ?? [];
const details = job.data.details ?? [];
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC'
});
function formatMonth(month: string) {
  return dateFormatter.format(new Date(month + '-01T00:00:00Z'));
}
const workDetails = [work.location, work.arrangement].filter(Boolean);
---

<article class="resume-job" aria-labelledby={`job-${job.id}`}>
  <header>
    <div class="job-heading">
      <h3 id={`job-${job.id}`}>
        {company.name}
        {company.description && (
          <span class="company-description">
            {' | '}
            <span class="company-description-text">{company.description}</span>
          </span>
        )}
      </h3>
      {workDetails.length > 0 && (
        <p class="job-work">{workDetails.join(' | ')}</p>
      )}
    </div>
    <div class="job-heading job-subheading">
      <p class="job-position">
        {position}
        {roles?.[0] && <span class="job-role"> | {roles[0]}</span>}
      </p>
      <p class="job-dates">
        <time datetime={start_month}>{formatMonth(start_month)}</time>
        <span aria-hidden="true"> – </span>
        {end_month ? (
          <time datetime={end_month}>{formatMonth(end_month)}</time>
        ) : (
          <span>Present</span>
        )}
      </p>
    </div>
  </header>
  {details.length > 0 && (
    <div class="job-bullets">
      <ul>
        {details.map((detail) => (
          <li
            data-kind={detail.kind}
            data-print-hide={
              respectPrintHide && detail.print_hide ? 'true' : undefined
            }
          >
            {detail.bullet}
          </li>
        ))}
      </ul>
    </div>
  )}
  {showTechnologies && technologies.length > 0 && (
    <p class="job-technologies">
      <strong>Key technologies:</strong> {technologies.join(', ')}
    </p>
  )}
</article>

<style>
  .resume-job {
    padding-block: 1rem;
    border-top: 1px solid var(--ink);
  }

  .job-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.35;
  }

  .company-description {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .job-dates {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .job-subheading {
    margin-top: 0.25rem;
  }

  .job-position {
    font-size: 0.875rem;
    font-weight: 650;
  }

  .job-role {
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .job-work {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .job-bullets {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .job-technologies {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .job-bullets :global(ul) {
    list-style: square;
    padding-left: 1.15rem;
  }

  .job-bullets :global(li + li) {
    margin-top: 0.25rem;
  }

  .job-bullets :global(a) {
    color: var(--link);
    text-decoration: underline;
  }
</style>
