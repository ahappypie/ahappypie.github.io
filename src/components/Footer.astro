---
import LinkedIn from './icons/LinkedIn.svg';
import GitHub from './icons/GitHub.svg';
---

<footer class="notebook-footer">
  <ul>
    <li>
      <a
        rel="noopener noreferrer"
        target="_blank"
        href="https://www.linkedin.com/in/bbagdasarian"
      >
        <LinkedIn width={18} height={18} aria-hidden="true" focusable="false" />
        linkedin
      </a>
    </li>
    <li>
      <a
        rel="noopener noreferrer"
        target="_blank"
        href="https://github.com/ahappypie"
      >
        <GitHub
          width={18}
          height={18}
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        />
        github
      </a>
    </li>
  </ul>
</footer>
