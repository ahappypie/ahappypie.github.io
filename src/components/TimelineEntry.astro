---
interface Props {
  time: string;
  title: string;
  items: string[];
  isLatest?: boolean;
}
const { time, title, items, isLatest = false } = Astro.props;
---

<li class="timeline-entry">
  <div class="timeline-meta">
    <time>{time}</time>
    {isLatest && <span class="latest-label">Latest</span>}
  </div>
  <div class="timeline-detail">
    <h3>{title}</h3>
    <ul>
      {items.map((i) => (
        <li>{i}</li>
      ))}
    </ul>
  </div>
</li>
