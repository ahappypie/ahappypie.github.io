---
import type { ResumeAudience } from '../lib/resume-audiences';

interface Props {
  audience: ResumeAudience;
}
const { audience } = Astro.props;
const audiences = [
  { kind: 'all', label: 'All', href: '/resume' },
  { kind: 'tech', label: 'Technical', href: '/resume/tech' },
  { kind: 'business', label: 'Business', href: '/resume/business' }
];
---

<nav class="resume-audiences" aria-label="Resume audience">
  <span>Audience</span>
  {audiences.map(({ kind, label, href }) => (
    <a href={href} aria-current={audience === kind ? 'page' : undefined}>
      {label}
    </a>
  ))}
</nav>

<style>
  .resume-audiences {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--ink);
    color: var(--ink);
    text-decoration: none;
  }

  a[aria-current='page'] {
    background: var(--accent);
  }

  @media print {
    .resume-audiences {
      display: none;
    }
  }
</style>
