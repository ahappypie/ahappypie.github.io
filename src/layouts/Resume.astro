---
import Head from '../components/Head.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Printer from '@lucide/astro/icons/printer';
import ResumeAudiences from '../components/ResumeAudiences.astro';
import type { ResumeAudience } from '../lib/resume-audiences';
import '../styles/global.css';
import '../styles/resume-print.css';

interface Props {
  title: string;
  audience?: ResumeAudience;
  showAudienceSelector?: boolean;
}
const { title, audience = 'all', showAudienceSelector = true } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr" class="resume-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Head
      title={title}
      description="Brian Bagdasarian's professional resume."
    />
  </head>
  <body>
    <div class="resume-preview">
      <nav class="resume-controls" aria-label="Resume navigation">
        <a href="/about">← Back to about</a>
        <div class="resume-actions">
          <div class="print-help">
            <button
              class="resume-print-button"
              type="button"
              aria-describedby="print-hint"
              hidden
            >
              <Printer width={16} height={16} aria-hidden="true" />
              Print / Save as PDF
            </button>
            <p class="print-hint" id="print-hint" role="tooltip">
              For PDF: choose US Letter, 100% scale, and turn off browser
              headers and footers.
            </p>
          </div>
          <ThemeToggle />
        </div>
      </nav>
      {showAudienceSelector && <ResumeAudiences audience={audience} />}
      <main class="resume-document">
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  const printButton = document.querySelector<HTMLButtonElement>(
    '.resume-print-button'
  );
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', async () => {
      await document.fonts.ready;
      window.print();
    });
  }
</script>

<style>
  .resume-preview {
    width: min(100% - 2.5rem, 52rem);
    margin: clamp(1.5rem, 5vw, 3rem) auto 4rem;
  }

  .resume-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .resume-controls a {
    padding-block: 0.75rem;
    color: var(--ink);
    text-decoration: underline;
  }

  .resume-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .print-help {
    position: relative;
  }

  .resume-print-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--ink);
    background: var(--accent);
    color: var(--ink);
    cursor: pointer;
  }

  .resume-print-button[hidden] {
    display: none;
  }

  .resume-print-button:hover {
    background: var(--surface);
  }

  .print-hint {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 1;
    width: min(20rem, calc(100vw - 6rem));
    padding: 0.75rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans), sans-serif;
    font-size: 0.75rem;
    line-height: 1.5;
    visibility: hidden;
  }

  .print-help:hover .print-hint,
  .print-help:focus-within .print-hint {
    visibility: visible;
  }

  .resume-document {
    padding: clamp(1rem, 4vw, 2rem);
    border: 1px solid var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
    font-size: 0.8125rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
</style>
